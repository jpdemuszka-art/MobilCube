# Gemini API key (Google AI Studio). Never commit the real key.
GEMINI_API_KEY=your_key_here

# Image model. Override if Google renames it. Options seen in 2026:
#   gemini-2.5-flash-image        (fast, good for ad creative iteration)
#   imagen-4.0-generate-001       (via ai.models.generateImages)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Output folder
OUT_DIR=./out
