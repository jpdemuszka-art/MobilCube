# Gemini API key (Google AI Studio). Never commit the real key.
GEMINI_API_KEY=your_key_here

# Image model (ai.google.dev/gemini-api/docs/models, checked 2026-09-26):
#   gemini-3.1-flash-image   Nano Banana 2  ~US$0.067 per 1K image, $0.101 per 2K   (default)
#   gemini-3-pro-image       Nano Banana Pro ~US$0.134 per 1K/2K image, best text-free realism
#   gemini-2.5-flash-image   Nano Banana (legacy) ~US$0.039 per image
#   imagen-4.0-generate-001  Imagen (uses ai.models.generateImages)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 1K, 2K or 4K (ignored by gemini-2.5-flash-image). 2K masters crop cleanly to 1200x1200 and 1200x628.
GEMINI_IMAGE_SIZE=2K

# Output folder
OUT_DIR=./out
